# =============================================================================
# Environment configuration — EXAMPLE FILE
# =============================================================================
#
# Copy to .env and fill in real values:      cp .env.example .env
#
# .env is git-ignored and MUST stay that way. Every value below is a safe
# placeholder; nothing here is a real credential.
#
# Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================


# --- Runtime -----------------------------------------------------------------

# development | production | test
# Production mode enables Secure cookies and HSTS, and refuses to boot without
# a real SESSION_SECRET.
NODE_ENV=development

PORT=3000

# Public origin of the deployed site. Used for canonical URLs, the sitemap, and
# for recognising internal referrers. No trailing slash.
SITE_URL=http://localhost:3000

# Number of reverse proxies in front of the app.
# 0 locally; 1 behind a single proxy (Render, Railway, Fly, nginx).
# NEVER set this to `true` — that makes the app trust any client-supplied
# X-Forwarded-For header, which lets an attacker spoof their IP and walk
# straight through every rate limiter.
TRUST_PROXY=0

# error | warn | info | debug
LOG_LEVEL=debug


# --- PostgreSQL --------------------------------------------------------------

# Managed providers (Neon, Supabase, Render) hand out a single connection
# string. When DATABASE_URL is set it takes precedence over the parts below.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_analytics
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password

# Enable TLS to the database. Required by most managed providers; leave false
# for a local PostgreSQL over a loopback connection.
DB_SSL=false

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000


# --- Administrator sessions ---------------------------------------------------

# REQUIRED IN PRODUCTION. At least 32 characters of cryptographic randomness.
# The app refuses to start in production without it, or with this placeholder.
# Rotating it signs out every admin session and invalidates the login audit
# IP hashes — both are intended.
SESSION_SECRET=replace-me-with-48-random-bytes-see-command-at-top-of-file

SESSION_COOKIE_NAME=portfolio_admin_sid

# Rolling session lifetime. 8 hours.
SESSION_TTL_MS=28800000


# --- Analytics ----------------------------------------------------------------

VISITOR_COOKIE_NAME=portfolio_visitor

# 365 days. Long enough for returning-visitor analysis to be meaningful.
VISITOR_COOKIE_MAX_AGE_MS=31536000000

# Inactivity after which a visit is considered over. 30 minutes is the
# long-standing web-analytics convention.
ANALYTICS_SESSION_TIMEOUT_MS=1800000

# Retention window, enforced by a scheduled prune job and documented on
# /privacy. Reducing this deletes data on the next prune.
ANALYTICS_RETENTION_DAYS=400


# --- Security -----------------------------------------------------------------

# Comma-separated allowlist, ONLY for a split-origin deployment where the
# frontend and API are on different hosts. Leave empty for the recommended
# single-origin setup, where no cross-origin request ever occurs.
# CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=

# Failed logins permitted per IP per window before throttling.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=900000

# bcrypt cost factor. 12 is roughly 250ms per verification on modern hardware.
# Raise as hardware improves; every increment doubles the work.
BCRYPT_ROUNDS=12

# Send Strict-Transport-Security. Only over real HTTPS — sending it from a
# localhost HTTP server pins the browser and breaks development.
# Defaults to on in production.
# ENABLE_HSTS=true


# --- AI insights (entirely optional) -------------------------------------------

# The dashboard works fully without any of this. With AI_PROVIDER=none the
# console shows deterministic, rule-based insights instead.
#
# Only aggregated statistics are ever sent to a provider — counts, rates and
# page paths. Never a visitor identifier, a session, a referrer URL, a cookie
# or a credential. Inspect the exact payload at
# /api/admin/analytics/insights/snapshot before enabling this.

# none | anthropic | openai
AI_PROVIDER=none

AI_API_KEY=
AI_MODEL=claude-sonnet-5

# For OpenAI-compatible providers on a custom host.
# AI_BASE_URL=https://api.openai.com/v1

# Insights are cached against a digest of their input, so identical statistics
# are never sent to a model twice.
AI_CACHE_TTL_MS=1800000
AI_TIMEOUT_MS=20000


# --- Administrator bootstrap (optional, for non-interactive setup) --------------
#
# `npm run admin:create` normally prompts for these with the password not
# echoed. Setting them here is convenient for a deploy hook but leaves the
# password in the environment — prefer the interactive prompt.
#
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
